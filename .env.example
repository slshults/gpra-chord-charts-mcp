# Copy to .env on the server. Read by systemd via EnvironmentFile.
# Everything here is optional — without it the server runs fine and silently.

# GPRA's PostHog project key. Safe to expose (it's the same public write-only
# key the website ships to browsers), but kept out of git so the repo has no
# credentials of any kind in it.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Listener. HOST stays on loopback in production; nginx is the only thing that
# should reach this process.
PORT=2112
HOST=127.0.0.1

# Where to fetch the Chord of the Day from. Defaults to the production site, so
# leave it unset in production. Point it somewhere dead to exercise the
# unreachable path, which is what the test suite does.
# GPRA_API_BASE=https://guitarpracticeroutine.com
